<launch>

<rosparam file="$(find agv_mobile_robot_final_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="agv_mobile_robot_final" args="Revolute 10_position_controller Revolute 17_position_controller Revolute 23_position_controller Revolute 28_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/agv_mobile_robot_final/joint_states"/>
</node>

</launch>